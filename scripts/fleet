#!/usr/bin/env python3
"""仅使用 Python 标准库完成首部署环境检查和初始化。"""
import os,sys,pathlib,subprocess,platform,shutil,secrets,json,socket,urllib.request
repo=pathlib.Path(__file__).resolve().parent.parent
if (repo/'.env').exists():
 for line in (repo/'.env').read_text().splitlines():
  if line.strip() and not line.lstrip().startswith('#') and '=' in line:
   key,value=line.split('=',1)
   if key.startswith('FLEET_') or key in ('CHROME_VERSION','RUNNER_URL'):
    os.environ.setdefault(key,value.strip().strip('"').strip("'"))
root=pathlib.Path(os.environ.get('FLEET_DATA_ROOT','/var/lib/chrome-fleet')).resolve()
def run(args):
 return subprocess.run(args,capture_output=True,text=True)
def init():
 if os.geteuid()!=0:
  sys.exit('初始化需要创建固定UID目录，请用 sudo -E ./scripts/fleet init')
 if root in (pathlib.Path('/'),pathlib.Path('/opt'),pathlib.Path('/var'),pathlib.Path('/var/lib'),pathlib.Path('/etc'),pathlib.Path('/home'),pathlib.Path('/root'),pathlib.Path('/tmp')) or root==repo or repo in root.parents:
  sys.exit('请使用项目目录之外的专用数据目录；拒绝系统目录和源码目录，以免误改其他服务或把秘密打进镜像')
 if root.exists() and any(root.iterdir()) and not (root/'.chrome-fleet-data').exists() and not all((root/'secrets'/n).is_file() for n in ('master.key','admin-token','runner-token')):
  sys.exit('现有目录不是可识别的 Chrome Fleet 数据目录；请改用新的专用目录')
 root.mkdir(mode=0o700,parents=True,exist_ok=True)
 (root/'.chrome-fleet-data').touch(mode=0o600,exist_ok=True)
 for name in ['secrets','db','vault','profiles','artifacts','backups','tmp']:
  p=root/name;p.mkdir(mode=0o700,exist_ok=True);p.chmod(0o700)
 for name,content in [('master.key',secrets.token_bytes(32)),('admin-token',secrets.token_urlsafe(32).encode()),('runner-token',secrets.token_urlsafe(32).encode())]:
  p=root/'secrets'/name
  if not p.exists():
   fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
   with os.fdopen(fd,'wb') as f:f.write(content)
 env=repo/'.env'
 if not env.exists():
  env.write_text((repo/'.env.example').read_text().replace('/var/lib/chrome-fleet',str(root)));env.chmod(0o644)
 print(f'初始化完成。平台令牌位于 {root}/secrets/admin-token；主密钥须另行离线保管。未输出秘密。')
def doctor():
 failures=[]
 def check(name,ok,detail=''):
  print(('通过' if ok else '失败')+' · '+name+('：'+detail if detail else ''))
  if not ok:failures.append(name)
 check('架构',platform.system()=='Linux' and platform.machine() in ('x86_64','amd64'),platform.machine())
 for args,label in [(['docker','version'],'Docker Engine'),(['docker','compose','version'],'Docker Compose')]:
  try:r=run(args);check(label,r.returncode==0)
  except FileNotFoundError:check(label,False)
 check('磁盘空间',shutil.disk_usage(root if root.exists() else repo).free>2*1024**3,'至少需要2GiB，浏览器每实例另需容量')
 for name in ['master.key','admin-token','runner-token']:
  p=root/'secrets'/name
  try:valid=p.exists() and p.stat().st_mode&0o077==0
  except PermissionError:valid=False
  check('secret '+name,valid,'需要root读取权限检查' if not valid else '')
 marker=pathlib.Path('/run/chrome-fleet/firewall-ready.json')
 try:valid=json.loads(marker.read_text())['bootId']==pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()
 except (OSError,ValueError,KeyError):valid=False
 check('浏览器隔离策略',valid,'重启后执行 sudo ./scripts/fleet firewall')
 try:
  s=socket.socket();s.bind(('127.0.0.1',int(os.environ.get('FLEET_PORT','8080'))));s.close();detail='端口可用'
 except OSError:detail='端口被占用；已部署时请核对 /health'
 print('信息 · 管理端口：'+detail)
 try:
  r=run(['docker','image','inspect','chrome-fleet/browser:google-'+os.environ.get('CHROME_VERSION','155.0.8059.79')])
  check('Chrome镜像',r.returncode==0,'构建后通过更新兼容性测试检查sandbox、keyring与Cookie重建恢复')
 except FileNotFoundError:check('Chrome镜像',False,'Docker命令不可用')
 try:r=run(['docker','info','--format','{{json .SecurityOptions}}']);check('Docker seccomp',r.returncode==0 and 'seccomp' in r.stdout)
 except FileNotFoundError:pass
 if len(sys.argv)==3 and sys.argv[2]=='--runtime' and not failures:
  try:
   opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))
   token=(root/'secrets/runner-token').read_text().strip()
   request=urllib.request.Request(os.environ.get('RUNNER_URL','http://172.30.0.3:8091')+'/images/validate',data=json.dumps({'image':'chrome-fleet/browser:google-'+os.environ.get('CHROME_VERSION','155.0.8059.79')}).encode(),headers={'Authorization':'Bearer '+token,'Content-Type':'application/json'},method='POST')
   result=json.load(opener.open(request,timeout=300))
   check('真实Chrome兼容性',result.get('valid') is True and result.get('compatible') is True,'全新临时profile验证sandbox、keyring、Cookie/IndexedDB和容器重建，随后清理')
  except Exception:
   check('真实Chrome兼容性',False,'Runner不可达、忙碌或浏览器验证失败；检查服务与更新记录')
 sys.exit(1 if failures else 0)
if len(sys.argv) not in (2,3) or len(sys.argv)==3 and (sys.argv[1]!='doctor' or sys.argv[2]!='--runtime'):sys.exit('用法：./scripts/fleet init|doctor [--runtime]|firewall')
if sys.argv[1]=='init':init()
elif sys.argv[1]=='doctor':doctor()
elif sys.argv[1]=='firewall':os.execvp('sh',['sh',str(repo/'docker/browser/install-firewall.sh')])
else:sys.exit('未知命令')
