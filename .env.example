# 只开放本机；HTTPS反向代理需同时设置PUBLIC_URL与COOKIE_SECURE
FLEET_BIND_ADDRESS=127.0.0.1
FLEET_PORT=8080
FLEET_PUBLIC_URL=http://127.0.0.1:8080
# 如需局域网/WireGuard访问，显式设置绑定和实际URL；来源仅允许精确列出的主机与端口。
# FLEET_BIND_ADDRESS=0.0.0.0
# FLEET_PUBLIC_URL=http://你的服务器IP:8080
# FLEET_ALLOWED_ORIGINS=http://你的服务器IP:8080,http://你的WireGuardIP:8080
FLEET_ALLOWED_ORIGINS=
FLEET_COOKIE_SECURE=false
FLEET_DATA_ROOT=/var/lib/chrome-fleet
FLEET_MAX_CONCURRENCY=3
CHROME_VERSION=155.0.8059.79
# 与防火墙FLEET_ALLOWED_CIDRS共同配置，避免广泛允许私网
FLEET_ALLOWED_PRIVATE_HOSTS=
# 通常留空：全Fleet TCP-only的兼容管理员例外，空格分隔IPv4:端口。
# 普通实例代理自动按来源和端点同步TCP+UDP，无需手工填写此项。
# 此兼容项不接受域名/URL/IPv6，修改后由 sudo ./scripts/fleet firewall 安装。
# FLEET_ALLOWED_PROXY_ENDPOINTS="192.168.50.20:8888 192.168.1.20:3128"
FLEET_ALLOWED_PROXY_ENDPOINTS=
