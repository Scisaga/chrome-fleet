[Unit]
Description=Chrome Fleet control services
Requires=docker.service chrome-fleet-firewall.service
After=docker.service chrome-fleet-firewall.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/chrome-fleet
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop control-plane runner
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
